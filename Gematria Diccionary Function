from googletrans import Translator

# ============================================
# FUNCIÓN 1: Buscar palabra en cualquier idioma
# ============================================
def buscar_palabra(palabra):
    """Detecta el idioma y traduce la palabra al inglés."""
    try:
        translator = Translator()
        deteccion = translator.detect(palabra)
        traduccion = translator.translate(palabra, src='auto', dest='en')
        return {
            'original': palabra,
            'idioma': deteccion.lang,
            'ingles': traduccion.text,
            'exito': True
        }
    except Exception as e:
        print(f"Error al buscar palabra: {e}")
        return {'exito': False}


# ============================================
# FUNCIÓN 2: Traducir palabra a hebreo
# ============================================
def traducir_a_hebreo(palabra):
    """Traduce cualquier palabra al hebreo."""
    try:
        translator = Translator()
        # En googletrans, el código para hebreo es 'he'
        return translator.translate(palabra, src='auto', dest='he').text
    except Exception as e:
        print(f"Error al traducir a hebreo: {e}")
        return None


# ============================================
# FUNCIÓN 3: Calcular valor gemátrico
# ============================================
def calcular_gematria(palabra_hebrea):
    """Suma el valor de cada letra hebrea."""
    gematria = {
        'א': 1, 'ב': 2, 'ג': 3, 'ד': 4, 'ה': 5,
        'ו': 6, 'ז': 7, 'ח': 8, 'ט': 9,
        'י': 10, 'כ': 20, 'ל': 30, 'מ': 40,
        'נ': 50, 'ס': 60, 'ע': 70, 'פ': 80, 'צ': 90,
        'ק': 100, 'ר': 200, 'ש': 300, 'ת': 400,
        'ך': 500, 'ם': 600, 'ן': 700, 'ף': 800, 'ץ': 900
    }

    total = 0
    for letra in palabra_hebrea:
        total += gematria.get(letra, 0)

    return total


# ============================================
# FUNCIÓN PRINCIPAL: Combina los 3 pasos
# ============================================
def gematria_completo(palabra):
    """Ejecuta búsqueda, traducción a hebreo y cálculo gemátrico."""
    info = buscar_palabra(palabra)
    if not info['exito']:
        return None

    hebreo = traducir_a_hebreo(palabra)
    if not hebreo:
        return None

    valor = calcular_gematria(hebreo)

    print(f"\n{palabra} ({info['ingles']}) -> {hebreo} = {valor}")
    return {
        'original': palabra,
        'ingles': info['ingles'],
        'hebreo': hebreo,
        'gematria': valor
    }


# ============================================
# EJECUCIÓN
# ============================================
if __name__ == "__main__":
    while True:
        palabra = input("\nPalabra (o 'salir'): ").strip()

        if palabra.lower() in ['salir', 'exit', 'quit']:
            break

        if palabra:
            gematria_completo(palabra)
